# Server port for Express backend
PORT=5000

# MongoDB connection string URI
MONGODB_URI=mongodb://localhost:27017/citywatch

# Secret key used for signing and verifying JSON Web Tokens (JWT)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Frontend client origin URL allowed for CORS requests
CLIENT_URL=http://localhost:3000

# Web Push VAPID Public Key for browser client subscription
VAPID_PUBLIC_KEY=BDqGtZYyTQHGUW_QFdcTR3G9NfvhfJ4oBQRVS6Z46DKLhY1Q3DjtNnCzRnefVtPm76t0LGqJyuEp0Zv3q9dbNM0

# Web Push VAPID Private Key for server payload signing
VAPID_PRIVATE_KEY=your_vapid_private_key_here

# Contact email (mailto: address) for Web Push specification compliance
VAPID_CONTACT_EMAIL=mailto:admin@citywatch.org
